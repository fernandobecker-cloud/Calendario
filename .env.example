EMARSYS_CLIENT_ID=
EMARSYS_CLIENT_SECRET=
EMARSYS_ACCOUNT_ID=
EMARSYS_TOKEN_URL=https://auth.emarsys.net/oauth2/token
EMARSYS_OAUTH_SCOPE=openid campaign analytics email
EMARSYS_CAMPAIGNS_URL=https://api.emarsys.net/api/v3/email
EMARSYS_CORE_BASE_URL=https://api.emarsys.net

# Automacao de envio de listas por loja (backend/routes/emarsys_segments.py) -
# reaproveita EMARSYS_CLIENT_ID/EMARSYS_CLIENT_SECRET/EMARSYS_TOKEN_URL acima.
# EMARSYS_BASE_URL: dominio+versao confirmados via Postman collection publica
# da Emarsys (github.com/emartech/Emarsys-postman-collection) - v2 classico
# exige WSSE (nunca aceita OIDC), v3 aceita. Ainda falta confirmar que o
# client OAuth tem permissao/scope liberado - rode GET /api/emarsys/discover.
EMARSYS_BASE_URL=https://api.emarsys.net/api/v3
EMARSYS_SEGMENT_LIST_PATH=/filter
EMARSYS_EXPORT_PATH=/export/filter
EMARSYS_DISTRIBUTION_METHOD=local
# Nome do campo de codigo de loja no CSV exportado pela Emarsys.
EMARSYS_CAMPO_LOJA_EXPORT=codigo_loja

# GET /export/{id}/data nao funciona nessa conta (rota nao implementada de
# fato) - exports "local" caem numa pasta WebDAV hospedada pela Emarsys,
# autenticacao HTTP Basic separada do Client ID/Secret OIDC acima (tela
# "Configurações de segurança" > usuarios WebDAV, no Emarsys).
EMARSYS_WEBDAV_BASE_URL=https://suite63.emarsys.net/storage/iplace
EMARSYS_WEBDAV_USER=
EMARSYS_WEBDAV_PASSWORD=

# SMTP para o envio dos CSVs por loja aos gerentes/subgerentes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
